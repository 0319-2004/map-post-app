rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read:   if request.auth != null;                          // ログイン中なら全員読める
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid; // 自分のuidでのみ投稿
      allow update, delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;         // 自分の投稿だけ
    }
  }
}
